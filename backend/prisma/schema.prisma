// Prisma Schema for Sinar Harapan Frontdesk & PMS
// Based on Arsitektur.md §4.2 DDL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  RECEPTIONIST
  MANAGER
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  MAINTENANCE
}

enum BookingSource {
  REDDOORZ
  WALK_IN
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum WaDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// 1. TABEL PENGGUNA & PERAN (AUTH & RBAC)
model User {
  id           String        @id @default(uuid())
  username     String        @unique @db.VarChar(50)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  fullName     String        @map("full_name") @db.VarChar(100)
  role         Role          @default(RECEPTIONIST)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  reservations Reservation[]
  activityLogs ActivityLog[]

  @@map("users")
  @@index([username])
}

// 2. TABEL MASTER INVENTARIS KAMAR
model Room {
  id                String        @id @default(uuid())
  roomNumber        String        @unique @map("room_number") @db.VarChar(10)
  roomType          String        @map("room_type") @db.VarChar(50) // Standard, Superior, Deluxe, Family
  floor             Int
  basePricePerNight Decimal       @map("base_price_per_night") @db.Decimal(12, 2)
  facilities        Json          @default("[]")
  status            RoomStatus    @default(AVAILABLE)
  deletedAt         DateTime?     @map("deleted_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  reservations      Reservation[]

  @@map("rooms")
  @@index([status])
  @@index([roomType, floor])
  @@index([deletedAt])
}

// 3. TABEL DATA INDUK TAMU (UU PDP COMPLIANT)
model Guest {
  id            String        @id @default(uuid())
  nik           String?       @unique @db.VarChar(16)
  fullName      String        @map("full_name") @db.VarChar(150)
  address       String?       @db.Text
  phoneWhatsapp String        @map("phone_whatsapp") @db.VarChar(20)
  ktpImageUrL   String?       @map("ktp_image_url") @db.Text // Encrypted signed URL (15m validity)
  createdAt     DateTime      @default(now()) @map("created_at")

  reservations  Reservation[]

  @@map("guests")
  @@index([nik])
  @@index([phoneWhatsapp])
}

// 4. TABEL TRANSAKSI RESERVASI
model Reservation {
  id                      String            @id @default(uuid())
  invoiceNumber           String            @unique @map("invoice_number") @db.VarChar(50) // INV/SH/YYYYMMDD/XXXX
  guestId                 String            @map("guest_id")
  roomId                  String            @map("room_id")
  bookingSource           BookingSource     @map("booking_source")
  reddoorzBookingCode     String?           @map("reddoorz_booking_code") @db.VarChar(50)
  checkInTime             DateTime          @map("check_in_time")
  expectedCheckOutTime    DateTime          @map("expected_check_out_time")
  actualCheckOutTime      DateTime?         @map("actual_check_out_time")
  totalNights             Int               @map("total_nights")
  roomRate                Decimal           @map("room_rate") @db.Decimal(12, 2)
  additionalCharges       Decimal           @default(0) @map("additional_charges") @db.Decimal(12, 2)
  additionalChargesDetail Json              @default("[]") @map("additional_charges_detail")
  totalAmount             Decimal           @map("total_amount") @db.Decimal(12, 2)
  paymentMethod           String            @map("payment_method") @db.VarChar(30) // CASH, QRIS, TRANSFER, REDDOORZ_PREPAID
  paymentStatus           PaymentStatus     @default(PAID) @map("payment_status")
  receptionistUserId      String?           @map("receptionist_user_id")
  waReminderSentAt        DateTime?         @map("wa_reminder_sent_at")
  waDeliveryStatus        WaDeliveryStatus? @map("wa_delivery_status")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  guest                   Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  room                    Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  receptionist            User?             @relation(fields: [receptionistUserId], references: [id])

  @@map("reservations")
  @@index([roomId])
  @@index([guestId])
  @@index([checkInTime])
  @@index([expectedCheckOutTime])
  @@index([invoiceNumber])
}

// 5. TABEL AUDIT LOG AKTIVITAS SISTEM
model ActivityLog {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  actionType   String    @map("action_type") @db.VarChar(50) // CHECK_IN, CHECK_OUT, CREATE_ROOM, EDIT_PRICE, EXPORT_REPORT, WA_REMINDER_FAILED
  resourceType String?   @map("resource_type") @db.VarChar(50)
  resourceId   String?   @map("resource_id")
  details      Json?
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User?     @relation(fields: [userId], references: [id])

  @@map("activity_logs")
  @@index([userId])
  @@index([actionType])
  @@index([createdAt])
}

// 6. TABEL TOKEN DICABUT (REVOKED TOKENS / DENYLIST UNTUK LOGOUT - BUG-BE-01)
model RevokedToken {
  id        String   @id @default(uuid())
  tokenJti  String   @unique @map("token_jti") @db.VarChar(255)
  userId    String?  @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("revoked_tokens")
  @@index([tokenJti])
  @@index([expiresAt])
}

// 7. TABEL COUNTER SEQUENCE INVOICE HARIAN ATOMIK PERSISTEN (BUG-BE-02)
model InvoiceCounter {
  id           String   @id @default(uuid())
  dateStr      String   @unique @map("date_str") @db.VarChar(8) // YYYYMMDD
  lastSequence Int      @default(0) @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("invoice_counters")
  @@index([dateStr])
}
